{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    // Vercel runs these functions as unbundled native ESM (the root
    // package.json has "type": "module"), not through a bundler — confirmed
    // the hard way by an ERR_MODULE_NOT_FOUND in production from relative
    // imports written without extensions. "bundler" resolution permits that
    // and stayed green; "nodenext" is what this directory actually runs
    // under, and requires the same extensioned specifiers Node's loader
    // does, so a missing ".js" is a compile-time error here from now on
    // instead of a runtime crash discovered in the deployment logs.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["."]
}
