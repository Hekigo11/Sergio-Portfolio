# Populated automatically by Vercel when you attach a Postgres (Neon) store
# to this project — no need to set manually in production.
DATABASE_URL=

# Resend (https://resend.com) — used for the contact form's owner
# notification and sender auto-reply.
RESEND_API_KEY=
# Must be on a domain verified with Resend to email arbitrary senders.
# Until then, leave unset to fall back to Resend's onboarding@resend.dev,
# which only delivers to CONTACT_TO_EMAIL (fine for the notification, not
# for the auto-reply).
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=jdeguzmansergio@gmail.com

# Any fixed string — salts the hashed IP used for comment rate-limiting.
IP_HASH_SALT=
