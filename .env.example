# Populated automatically by Vercel when you attach a Postgres (Neon) store
# to this project — no need to set manually in production.
DATABASE_URL=

# Web3Forms (https://web3forms.com) — relays a contact-form submission to
# the site owner's inbox. Free, and needs no domain of its own: create an
# access key at web3forms.com (no account required, just an email address to
# receive it), which also sets the destination inbox — that's configured
# there, not by an env var here.
#
# VITE_-prefixed, not a plain env var: Web3Forms rejects a server-to-server
# request by design (their own anti-spam measure — a 403, not a bug), so this
# is called from the browser after api/contact.ts has already saved the
# message, not from a Vercel function. That means it ships inside the public
# JS bundle, same as Web3Forms' own docs say is fine for this key ("don't
# worry, this can be public") — unlike every other secret in this file. See
# src/lib/web3forms.ts.
#
# What this can't do: send a reply *to* the visitor. Sending arbitrary
# outbound mail to a stranger who filled out a form is exactly the abuse
# surface every provider — free or paid — gates behind a verified sending
# domain. If that's wanted later, it needs a real domain and an ESP (Resend,
# etc.), not this.
VITE_WEB3FORMS_ACCESS_KEY=

# Any fixed string — salts the hashed IP used for comment rate-limiting.
IP_HASH_SALT=
